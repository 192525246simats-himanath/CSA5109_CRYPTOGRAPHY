import hashlib

p, q = 61, 53
n = p*q
phi = (p-1)*(q-1)
e = 17
d = pow(e, -1, phi)

msg = "Hello"
h = int(hashlib.sha256(msg.encode()).hexdigest(), 16) % n

sig = pow(h, d, n)
verify = pow(sig, e, n)

print("Message:", msg)
print("Signature:", sig)

if verify == h:
    print("Signature Verified")
else:
    print("Verification Failed")
